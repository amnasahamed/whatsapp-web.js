# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_command_center?schema=public"

# =============================================================================
# REDIS
# =============================================================================
# Redis for caching, sessions, and queues
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# =============================================================================
# AI PROVIDERS - OpenAI
# =============================================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# =============================================================================
# AI PROVIDERS - Anthropic (Claude)
# =============================================================================
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# =============================================================================
# AI PROVIDERS - Google Gemini
# =============================================================================
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# =============================================================================
# AI PROVIDERS - Custom LLM
# =============================================================================
# For self-hosted models (Ollama, LM Studio, etc.)
CUSTOM_LLM_ENDPOINT=http://localhost:11434/api/generate
CUSTOM_LLM_MODEL=llama2
CUSTOM_LLM_API_KEY=optional-if-required
CUSTOM_LLM_MAX_TOKENS=2000
CUSTOM_LLM_TEMPERATURE=0.7

# =============================================================================
# DEFAULT AI CONFIGURATION
# =============================================================================
# Which AI provider to use by default
# Options: openai, anthropic, gemini, custom
DEFAULT_AI_PROVIDER=openai

# Enable AI auto-response
AI_AUTO_RESPONSE_ENABLED=true

# AI response delay (ms) - adds human-like delay
AI_RESPONSE_DELAY_MIN=1000
AI_RESPONSE_DELAY_MAX=3000

# =============================================================================
# WHATSAPP CONFIGURATION
# =============================================================================
# WhatsApp session storage path
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Puppeteer configuration
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Chrome executable path (leave empty for auto-detect)
CHROME_EXECUTABLE_PATH=

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# LOGGING
# =============================================================================
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Pretty print logs in development
LOG_PRETTY=true

# =============================================================================
# FILE STORAGE
# =============================================================================
# Where to store media files
# Options: local, s3
FILE_STORAGE_TYPE=local

# Local file storage path
FILE_STORAGE_PATH=./storage/media

# S3 Configuration (if using S3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# WEBHOOKS
# =============================================================================
# Enable outgoing webhooks
WEBHOOKS_ENABLED=true

# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# =============================================================================
# ANALYTICS
# =============================================================================
# Enable analytics tracking
ANALYTICS_ENABLED=true

# Retention period (days)
ANALYTICS_RETENTION_DAYS=90

# =============================================================================
# EMAIL (Optional - for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# Sentry for error tracking
SENTRY_DSN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_TEAM_COLLABORATION=true
FEATURE_AUTOMATION_BUILDER=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_MULTI_ACCOUNT=true
FEATURE_BROADCAST_CAMPAIGNS=true

# =============================================================================
# SECURITY
# =============================================================================
# Enable CORS
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Session configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=604800000

# Encryption key for sensitive data
ENCRYPTION_KEY=your-32-char-encryption-key-here

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Skip authentication in development (NOT for production!)
SKIP_AUTH=false

# Enable debug mode
DEBUG=false
